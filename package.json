{
  "name": "dsh-liaojian",
  "version": "0.1.0",
  "description": "聊笺 · 微信 AI 工作台。导入微信流聊天归档，生成简报、待办、商机和内容选题。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": ["host/", "shared.js", "client/client.js", "cordis.patch.yml", "icon.svg", "locale/"],
  "keywords": ["dsh-plugin", "deepseek-harness", "wechat", "wechatbridge"],
  "engines": { "node": ">=24.9.0" },
  "dsh": {
    "engines": { "dsh": ">=0.2.2-rc.3 <0.3.0" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": { "yauzl": "3.4.0" },
  "devDependencies": { "esbuild": "0.25.12" }
}
