{
  "name": "dsh-liaojian",
  "version": "0.2.4",
  "description": "聊笺 · 微信 AI 工作台。接收微信流在 DeepSeek Harness 会话中的分析结果，归档微信原话。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "host/",
    "shared.js",
    "client/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "wechatbridge"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.3 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "markdown-it": "15.0.3"
  }
}
